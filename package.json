{
	"name": "devbar.sh",
	"version": "0.1.0",
	"description": "Drop-in toolbar for any website. Annotate the UI and capture selectors, computed styles, React component trees, and screenshots as an agent-ready prompt.",
	"keywords": [
		"ai agent",
		"annotation",
		"bug report",
		"chrome extension",
		"css selector",
		"design review",
		"devbar",
		"devbar.sh",
		"developer tools",
		"devtools",
		"element inspector",
		"llm",
		"mcp",
		"prompt",
		"qa",
		"react",
		"react component tree",
		"screenshot",
		"toolbar",
		"visual feedback",
		"xpath"
	],
	"homepage": "https://devbar.sh",
	"bugs": {
		"url": "https://github.com/TimMikeladze/devbar/issues"
	},
	"license": "MIT",
	"author": {
		"name": "Tim Mikeladze",
		"email": "tim.mikeladze@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/TimMikeladze/devbar.git"
	},
	"bin": {
		"devbar": "dist/bin/local-cli.js"
	},
	"workspaces": [
		"app",
		"test/**"
	],
	"files": [
		"dist/index.js",
		"dist/index.css",
		"dist/index.d.ts",
		"dist/shared",
		"dist/cdn",
		"dist/local",
		"dist/config",
		"dist/bin",
		"extension/manifest.json",
		"extension/background.js",
		"extension/devbar.cdn.js",
		"extension/example.html",
		"extension/icons"
	],
	"type": "module",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./local": {
			"import": {
				"types": "./dist/local/local.d.ts",
				"default": "./dist/local/local.js"
			}
		},
		"./config": {
			"import": {
				"types": "./dist/config/config.d.ts",
				"default": "./dist/config/config.js"
			}
		},
		"./cdn": "./dist/cdn/cdn.global.js",
		"./styles.css": "./dist/index.css",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "bunup && bun run build:extension",
		"build:extension": "bun run scripts/build-extension.ts",
		"dev": "bun run dev:lib & bun run dev:ui & bun run dev:app & bun run dev:server & wait",
		"dev:lib": "bunup --watch",
		"dev:ui": "bun run --cwd test/ui dev",
		"dev:app": "bun run --cwd app dev",
		"dev:local": "bun run dev:lib & bun run dev:app & bun run dev:server & bun --watch src/server/local-cli.ts --port 3101 & wait",
		"dev:server": "bun --watch src/server/cli.ts start",
		"format": "oxfmt . app",
		"lint": "oxlint . app",
		"prepare": "bun simple-git-hooks",
		"release": "bumpp --commit --push --tag",
		"test": "bun test test/*.test.ts",
		"test:e2e": "bunx playwright test",
		"test:coverage": "bun test --coverage",
		"test:watch": "bun test --watch",
		"type-check": "tsc --noEmit",
		"db:pg:generate": "drizzle-kit generate --config=drizzle.config.pg.ts",
		"db:pg:migrate": "drizzle-kit migrate --config=drizzle.config.pg.ts",
		"db:sqlite:generate": "drizzle-kit generate --config=drizzle.config.sqlite.ts",
		"db:sqlite:migrate": "drizzle-kit migrate --config=drizzle.config.sqlite.ts"
	},
	"dependencies": {
		"html-to-image": "^1.11.13",
		"jiti": "^2.6.1"
	},
	"devDependencies": {
		"@drizzle-team/brocli": "^0.11.0",
		"@libsql/client": "^0.17.0",
		"@modelcontextprotocol/sdk": "^1.27.1",
		"@playwright/test": "^1.58.2",
		"@types/bun": "^1.3.10",
		"@types/react": "^19.2.14",
		"better-auth": "^1.5.4",
		"bumpp": "^10.4.1",
		"bunup": "^0.16.31",
		"drizzle-kit": "^0.31.9",
		"drizzle-orm": "^0.45.1",
		"hono": "^4.12.5",
		"oxfmt": "^0.36.0",
		"oxlint": "^1.51.0",
		"postgres": "^3.4.8",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"simple-git-hooks": "^2.13.1",
		"stripe": "^20.4.1",
		"typescript": "^5.9.3"
	},
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0",
		"typescript": ">=4.5.0"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		}
	},
	"simple-git-hooks": {
		"pre-commit": "bun run format && bun run lint && bun run type-check"
	},
	"engines": {
		"node": ">=20"
	}
}
