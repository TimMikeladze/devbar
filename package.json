{
	"name": "deloop.dev",
	"version": "0.1.0",
	"description": "a drop-in toolbar into any website that lets user's annoate, capture xpaths, screenshots, and all contextual info in order to prompt an LLM with fixes",
	"homepage": "https://github.com/TimMikeladze/deloop#readme",
	"bugs": {
		"url": "https://github.com/TimMikeladze/deloop/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/TimMikeladze/deloop.git"
	},
	"bin": {
		"deloop.dev": "./dist/server/cli.js"
	},
	"workspaces": [
		"test/**"
	],
	"files": [
		"dist",
		"extension"
	],
	"type": "module",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./server": {
			"import": {
				"types": "./dist/server/index.d.ts",
				"default": "./dist/server/index.js"
			}
		},
		"./server/vercel": {
			"import": {
				"types": "./dist/server/vercel.d.ts",
				"default": "./dist/server/vercel.js"
			}
		},
		"./cdn": "./dist/cdn/cdn.global.js",
		"./styles.css": "./dist/index.css",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "bunup",
		"dev": "bun run dev:lib & bun run dev:ui & bun run dev:app & bun run dev:server & wait",
		"dev:lib": "bunup --watch",
		"dev:ui": "bun run --cwd test/ui dev",
		"dev:app": "bun run --cwd app dev",
		"dev:server": "bun --watch src/server/cli.ts start",
		"format": "oxfmt",
		"lint": "oxlint",
		"prepare": "bun simple-git-hooks",
		"release": "bumpp --commit --push --tag",
		"test": "bun test",
		"test:e2e": "bunx playwright test",
		"test:coverage": "bun test --coverage",
		"test:watch": "bun test --watch",
		"type-check": "tsc --noEmit",
		"db:pg:generate": "drizzle-kit generate --config=drizzle.config.pg.ts",
		"db:pg:migrate": "drizzle-kit migrate --config=drizzle.config.pg.ts",
		"db:sqlite:generate": "drizzle-kit generate --config=drizzle.config.sqlite.ts",
		"db:sqlite:migrate": "drizzle-kit migrate --config=drizzle.config.sqlite.ts"
	},
	"dependencies": {
		"@drizzle-team/brocli": "^0.11.0",
		"@libsql/client": "^0.17.0",
		"better-auth": "^1.5.4",
		"drizzle-orm": "^0.45.1",
		"hono": "^4.12.5",
		"html2canvas": "^1.4.1",
		"postgres": "^3.4.8",
		"stripe": "^20.4.1"
	},
	"devDependencies": {
		"@playwright/test": "^1.58.2",
		"@types/bun": "^1.3.10",
		"@types/react": "^19.2.14",
		"bumpp": "^10.4.1",
		"bunup": "^0.16.31",
		"drizzle-kit": "^0.31.9",
		"oxfmt": "^0.36.0",
		"oxlint": "^1.51.0",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"simple-git-hooks": "^2.13.1",
		"typescript": "^5.9.3"
	},
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0",
		"typescript": ">=4.5.0"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		}
	},
	"simple-git-hooks": {
		"pre-commit": "bun run format && bun run lint && bun run type-check"
	}
}
