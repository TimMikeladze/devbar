{
	"name": "deloop.dev",
	"version": "0.1.0",
	"description": "a drop-in toolbar into any website that lets user's annoate, capture xpaths, screenshots, and all contextual info in order to prompt an LLM with fixes",
	"homepage": "https://github.com/TimMikeladze/deloop#readme",
	"bugs": {
		"url": "https://github.com/TimMikeladze/deloop/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/TimMikeladze/deloop.git"
	},
	"workspaces": [
		"test/**"
	],
	"files": [
		"dist",
		"extension"
	],
	"type": "module",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./cdn": "./dist/cdn/cdn.global.js",
		"./styles.css": "./dist/index.css",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "bunup",
		"dev": "bun run --cwd test/ui dev",
		"format": "oxfmt",
		"lint": "oxlint",
		"prepare": "bun simple-git-hooks",
		"release": "bumpp --commit --push --tag",
		"test": "bun test",
		"test:e2e": "bunx playwright test",
		"test:coverage": "bun test --coverage",
		"test:watch": "bun test --watch",
		"type-check": "tsc --noEmit"
	},
	"dependencies": {
		"html2canvas": "^1.4.1"
	},
	"devDependencies": {
		"@playwright/test": "^1.58.2",
		"@types/bun": "^1.3.10",
		"@types/react": "^19.2.14",
		"bumpp": "^10.4.1",
		"bunup": "^0.16.31",
		"oxfmt": "^0.36.0",
		"oxlint": "^1.51.0",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"simple-git-hooks": "^2.13.1",
		"typescript": "^5.9.3"
	},
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0",
		"typescript": ">=4.5.0"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		}
	},
	"simple-git-hooks": {
		"pre-commit": "bun run format && bun run lint && bun run type-check"
	}
}
