{
	"name": "devbar.sh",
	"version": "2.0.0-rc.0",
	"description": "Drop-in toolbar for any website. Annotate the UI and capture selectors, computed styles, React component trees, and screenshots as an agent-ready prompt.",
	"keywords": [
		"ai agent",
		"annotation",
		"bug report",
		"chrome extension",
		"css selector",
		"design review",
		"devbar",
		"devbar.sh",
		"developer tools",
		"devtools",
		"element inspector",
		"llm",
		"mcp",
		"prompt",
		"qa",
		"react",
		"react component tree",
		"screenshot",
		"toolbar",
		"visual feedback",
		"xpath"
	],
	"homepage": "https://devbar.sh",
	"bugs": {
		"url": "https://github.com/TimMikeladze/devbar/issues"
	},
	"license": "MIT",
	"author": {
		"name": "Tim Mikeladze",
		"email": "tim.mikeladze@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/TimMikeladze/devbar.git"
	},
	"bin": {
		"devbar": "dist/bin/local-cli.js"
	},
	"workspaces": [
		"app",
		"test/**"
	],
	"files": [
		"dist/index.js",
		"dist/index.css",
		"dist/index.d.ts",
		"dist/shared",
		"dist/cdn",
		"dist/local",
		"dist/config",
		"dist/workspace",
		"dist/next",
		"dist/bin",
		"extension/manifest.json",
		"extension/background.js",
		"extension/devbar.cdn.js",
		"extension/example.html",
		"extension/icons"
	],
	"type": "module",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./local": {
			"import": {
				"types": "./dist/local/local.d.ts",
				"default": "./dist/local/local.js"
			}
		},
		"./config": {
			"import": {
				"types": "./dist/config/config.d.ts",
				"default": "./dist/config/config.js"
			}
		},
		"./workspace": {
			"import": {
				"types": "./dist/workspace/index.d.ts",
				"default": "./dist/workspace/index.js"
			}
		},
		"./next": {
			"import": {
				"types": "./dist/next/next.d.ts",
				"default": "./dist/next/next.js"
			}
		},
		"./cdn": "./dist/cdn/cdn.global.js",
		"./styles.css": "./dist/index.css",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "bunup && bun run build:extension",
		"build:extension": "bun run scripts/build-extension.ts",
		"package:extension": "bun run scripts/package-extension.ts",
		"dev": "bun run dev:lib & bun run dev:ui & bun run dev:app & wait",
		"dev:lib": "bunup --watch",
		"dev:ui": "bun run --cwd test/ui dev",
		"dev:app": "bun run --cwd app dev",
		"dev:local": "bun run dev:lib & bun run dev:app & bun --watch src/server/local-cli.ts --port 3101 & wait",
		"format": "oxfmt . app",
		"lint": "oxlint . app",
		"og": "bun run scripts/generate-og.ts",
		"prepare": "bun simple-git-hooks",
		"release": "bumpp --commit --push --tag",
		"screenshots": "bun run scripts/screenshots.ts",
		"test": "bun test test/*.test.ts",
		"test:e2e": "bunx playwright test",
		"test:coverage": "bun test --coverage",
		"test:watch": "bun test --watch",
		"type-check": "tsc --noEmit"
	},
	"dependencies": {
		"html-to-image": "^1.11.13",
		"jiti": "^2.7.0",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@types/bun": "^1.4.4",
		"@types/react": "^19.3.0",
		"bumpp": "^12.3.0",
		"bunup": "^0.16.32",
		"oxfmt": "0.74.0",
		"oxlint": "1.89.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"simple-git-hooks": "^2.14.0",
		"typescript": "^5.9.3"
	},
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0",
		"typescript": ">=4.5.0"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		}
	},
	"overrides": {
		"esbuild": "^0.28.2"
	},
	"simple-git-hooks": {
		"pre-commit": "bun run format && bun run lint && bun run type-check"
	},
	"engines": {
		"node": ">=20"
	}
}
