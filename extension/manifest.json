{
	"manifest_version": 3,
	"name": "Deloop",
	"version": "0.1.0",
	"description": "Annotate any website to prompt an LLM with fixes",
	"permissions": ["activeTab", "scripting"],
	"action": {
		"default_title": "Toggle Deloop"
	},
	"icons": {
		"16": "icons/icon-16.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	},
	"background": {
		"service_worker": "background.js"
	}
}
